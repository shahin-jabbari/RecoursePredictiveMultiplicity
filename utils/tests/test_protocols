class StatisticalProtocol(unittest.TestCase):
    def test_seeds_not_instances_are_inference_units(self):
        rows=[{'seed':1,'valid':0}]*9+[{'seed':2,'valid':1}]
        result=stats.metric_summary(rows,'valid')
        self.assertAlmostEqual(result['mean'],.5)
        self.assertEqual(result['n_seeds'],2)

    def test_zero_variance_is_flagged(self):
        result=stats.mean_ci([100,100])
        self.assertTrue(np.isnan(result['ci_low']))
        self.assertEqual(result['ci_status'],'zero_observed_seed_variance')

    def test_worst_model_and_every_individual_differ(self):
        rows=[]
        for seed in [1,2]:
            for j,values in enumerate([(1,0),(0,1)]):
                for i,value in enumerate(values):
                    rows.append(dict(source_version='v6',source_mode='quick',dataset='Synthetic',
                        family='differentiable',aggregation='probability',config='2 LR',
                        n_models=2,budget=1.,seed=seed,instance_id=j,model_index=i,
                        individual_valid=bool(value),joint_valid=False,certified_infeasible=False))
        seeds,summary,_=burden.summarize(rows)
        self.assertTrue((seeds.worst_individual_validity==50).all())
        self.assertTrue((seeds.all_individually_validity==0).all())
        self.assertTrue((seeds.burden_worst==50).all())


class OraclesAndArtifacts(unittest.TestCase):
    def test_convex_bounds_contain_independent_optimum(self):
        oracle=gap.ConvexLogitOracle(logits(),[0.],1.)
        for w in [np.array([.5,.5]),np.array([.1,.9])]:
            point,info=oracle.solve(w)
            ref=minimize_scalar(lambda z:w@oracle.losses([z]),bounds=(-1.,1.),method='bounded')
            truth=min(ref.fun,w@oracle.losses([-1.]),w@oracle.losses([1.]))
            self.assertLessEqual(info['lower_bound'],truth+1e-8)
            self.assertGreaterEqual(info['objective'],truth-1e-8)

    def test_gap_uses_preupdate_weights_and_average_point(self):
        point,rows,trace=gap.convex_trajectory(logits(),np.array([0.]),1.,T=7,every=3)
        self.assertEqual([r['round'] for r in rows],[1,3,6,7])
        for r in rows:
            n=r['round']
            np.testing.assert_allclose(r['average_weights'],trace['weights'][:n].mean(axis=0))
            np.testing.assert_allclose(r['average_point'],trace['points'][:n].mean(axis=0))
            self.assertLessEqual(r['gap_upper_bound'],r['theory_upper_bound']+1e-6)

    def test_quick_inner_budget_is_applied(self):
        token=rr._ACTIVE_SETTINGS.set({'inner_oracle_steps':3})
        try:
            p=rc.oracle_gradient_descent([.5,.5],logits(),torch.tensor([0.]),1.,rc.recourse_loss,num_steps=20)
            self.assertEqual(p.recourse_info['inner_steps'],3)
        finally:rr._ACTIVE_SETTINGS.reset(token)

    def test_training_cache_preserves_weights_and_depends_on_labels(self):
        X=np.array([[-1.],[1.]],dtype=np.float32);y=np.array([0,1])
        rc._TRAINING_CACHE.clear()
        a=rc.train_model(rc.LogisticRegressionModel(1,42),X,y,epochs=4,seed=42)
        b=rc.train_model(rc.LogisticRegressionModel(1,42),X,y,epochs=4,seed=42)
        for k,v in a.state_dict().items():torch.testing.assert_close(v,b.state_dict()[k],rtol=0,atol=0)
        self.assertTrue(b.training_settings['cache_hit'])
        c=rc.train_model(rc.LogisticRegressionModel(1,42),X,1-y,epochs=4,seed=42)
        self.assertFalse(torch.equal(a.linear.weight,c.linear.weight))

    def test_modes_and_repeated_invocations_cannot_clobber_results(self):
        old=rr.NOTEBOOK_VERSION,rr.RESULTS_ROOT,rc.RESULTS_DIR
        try:
            with tempfile.TemporaryDirectory() as d:
                rr.configure_notebook('v6',d)
                a=rr.start_notebook_experiment('example','quick')
                (a/'sentinel.txt').write_text('previous run')
                b=rr.start_notebook_experiment('example','quick')
                c=rr.start_notebook_experiment('example','full')
                self.assertEqual((a/'sentinel.txt').read_text(),'previous run')
                self.assertEqual(len({a,b,c}),3)
                self.assertIn('quick',a.parts);self.assertIn('full',c.parts)
        finally:rr.NOTEBOOK_VERSION,rr.RESULTS_ROOT,rc.RESULTS_DIR=old


class TreeConsistency(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        try:runtime.solver_check()
        except RuntimeError as exc:raise unittest.SkipTest(str(exc))

    def test_opposite_splits_cannot_both_choose_favorable_leaf(self):
        models=[trees.TreeModel([stump(1,0)],1),trees.TreeModel([stump(0,1)],1)]
        solver=trees.TreeOracle(models,torch.tensor([-.25]),1.,time_limit=2.)
        try:
            p=solver.solve([.5,.5])
            self.assertTrue(p.recourse_info['incumbent_verified'])
            self.assertAlmostEqual(p.recourse_info['objective'],.5,places=7)
            p=solver.solve(objective='minimax')
            self.assertAlmostEqual(p.recourse_info['objective'],1.,places=7)
        finally:solver.close()

    def test_narrow_valid_region_is_preserved(self):
        models=[trees.TreeModel([stump(0,1,0.)],1),trees.TreeModel([stump(1,0,1e-10)],1)]
        solver=trees.TreeOracle(models,torch.tensor([-.25]),1.,time_limit=2.)
        try:
            p=solver.solve(objective='minimax')
            self.assertTrue(p.recourse_info['incumbent_verified'])
            np.testing.assert_array_equal(trees.probabilities(models,p),[1.,1.])
            self.assertGreater(float(p[0]),0);self.assertLessEqual(float(p[0]),1e-10)
        finally:solver.close()


