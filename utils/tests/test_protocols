def logits(slopes=(1.3,-.8),biases=(-.2,.5)):
    result=[]
    for a,b in zip(slopes,biases):
        m=rc.LogisticRegressionModel(1,42)
        rc.set_model_weights(m,torch.tensor([a,b]))
        result.append(m)
    return result


def stump(left,right,threshold=0.):
    return trees.TreeSpec(np.array([1,-1,-1]),np.array([2,-1,-1]),
        np.array([0,-2,-2]),np.array([threshold,-2.,-2.]),np.array([.5,left,right]))


